# E2E Testing Configuration
# Copy to .env.e2e.local and fill with real values

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Bootstrap
ADMIN_EMAIL=admin@wisper.com
ADMIN_PASSWORD=your-secure-password
ADMIN_FULL_NAME=Admin Wisper

# E2E Test User
E2E_TECH_EMAIL=tecnico.e2e@wisper.com
E2E_TECH_PASSWORD=test-password-123
E2E_TECH_NAME=Técnico E2E

# Google Maps (optional for maps/routes)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_ROUTES_API_KEY=your-google-routes-key
