# Bootstrap Super Admin Configuration
# Copy this file to your deployment platform's secret/environment management
# NEVER commit actual credentials to git

# Supabase Configuration (same as application)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Bootstrap Super Admin Credentials
# These are ONLY used during initial deployment to create the first SUPER_ADMIN
# Subsequent runs will detect the existing user and exit successfully

BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeThisSecurePassword123!
BOOTSTRAP_SUPER_ADMIN_NAME=Super Administrator

# Security Notes:
# 1. Use a strong password (min 8 chars, uppercase, lowercase, number)
# 2. Change the password after first login
# 3. Store these credentials in your team's password manager
# 4. Use your platform's secret management:
#    - Vercel: Project Settings → Environment Variables
#    - AWS: Secrets Manager or Parameter Store
#    - Docker: Docker secrets or encrypted env files
#    - Heroku: Config Vars
# 5. Never expose SERVICE_ROLE_KEY to client-side code
# 6. Rotate credentials regularly

# Deployment Platforms:
#
# Vercel:
#   Add these in: Project Settings → Environment Variables → Production
#
# Docker:
#   Pass via: docker run --env-file .env.bootstrap.secure
#   Or use: Docker secrets (recommended)
#
# AWS ECS:
#   Store in: AWS Secrets Manager
#   Reference in: Task Definition environment variables
#
# Kubernetes:
#   Create: kubectl create secret generic bootstrap-credentials --from-env-file=.env.bootstrap.secure
#   Mount as: environment variables in deployment
