{
  "name": "wisper-logistica",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:technician": "cd apps/technician && npm start",
    "build:admin": "cd apps/admin && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "create-admin": "node scripts/create-admin.mjs",
    "bootstrap:super-admin": "node scripts/bootstrap-super-admin.mjs",
    "health-check": "node scripts/health-check.mjs",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "test:sla": "node scripts/test-sla.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:bootstrap": "node scripts/test-bootstrap-super-admin.mjs",
    "test:e2e": "npm run health-check && npm run test:sla && npm run test:rls && npm run test:storage",
    "eas-build-post-install": "npm run build --workspace=packages/shared"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2"
  },
  "overrides": {
    "react": "19.2.8",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "@expo/fingerprint": "0.20.11",
    "@expo/log-box": "57.0.4",
    "expo-asset": "57.0.15",
    "expo-file-system": "57.0.6",
    "expo-modules-core": "57.0.14",
    "expo-modules-jsi": "57.0.6",
    "expo-font": "57.0.2"
  }
}
