# ============================================
# TICKETING PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.production and fill with real values
# NEVER commit .env.production to git
# ============================================

# ============================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================

# Supabase Project URL
# Type: BUILD-TIME + RUNTIME (NEXT_PUBLIC_*)
# Location: Supabase Dashboard → Project Settings → API
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key
# Type: BUILD-TIME + RUNTIME (NEXT_PUBLIC_*)
# Location: Supabase Dashboard → Project Settings → API → anon/public key
# Security: Safe to expose in client-side code (protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key
# Type: RUNTIME SERVER ONLY (SECRET - NEVER EXPOSE TO CLIENT)
# Location: Supabase Dashboard → Project Settings → API → service_role key
# Security: CRITICAL - Has full database access, bypasses RLS
# Usage: Server-side API routes only (/api/*)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ============================================
# EXTERNAL SERVICES (OPTIONAL)
# ============================================

# OSRM Routing Service
# Type: RUNTIME SERVER ONLY
# Default: https://router.project-osrm.org (public OSRM instance)
# Usage: Driving route calculations in /api/routes/driving
# Custom: Set if using self-hosted OSRM instance
# ROUTING_BASE_URL=https://router.project-osrm.org

# Photon Geocoding Service
# Type: RUNTIME SERVER ONLY
# Default: https://photon.komoot.io (public Photon instance)
# Usage: Address geocoding/reverse geocoding in /api/geocode and /api/reverse-geocode
# Custom: Set if using self-hosted Photon instance
# GEOCODING_BASE_URL=https://photon.komoot.io

# ============================================
# VARIABLE CLASSIFICATION
# ============================================
#
# BUILD-TIME (NEXT_PUBLIC_*):
#   - Required during Docker build
#   - Passed as --build-arg to docker build
#   - Baked into client-side JavaScript bundle
#   - Visible in browser DevTools
#   - Cannot be changed without rebuild
#
# RUNTIME SERVER:
#   - Required only at runtime
#   - Passed as environment variables to container
#   - Available only in server-side code (/api/*)
#   - NEVER exposed to client
#   - Can be changed without rebuild (just restart container)
#
# SECRET:
#   - MUST be kept confidential
#   - NEVER commit to git
#   - NEVER log or expose in responses
#   - Store securely (e.g., vault, encrypted env files)
#
# ============================================
